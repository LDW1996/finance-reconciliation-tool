{
  "scripts": {
    "dev": "concurrently \"npm run api\" \"npm run frontend:dev\"",
    "api": ".venv/bin/uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000 --reload",
    "frontend:dev": "npm run dev --prefix frontend",
    "frontend:build": "npm run build --prefix frontend",
    "test": "PYTHONPATH=backend .venv/bin/python -m pytest backend/tests -q"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
